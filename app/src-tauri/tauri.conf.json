{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SAP GUI Launcher",
  "version": "../package.json",
  "identifier": "sapguilauncher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SAP GUI Launcher",
        "width": 1070,
        "height": 660,
        "minWidth": 680,
        "minHeight": 420,
        "preventOverflow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "SAP GUI Launcher",
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAxMkE1MzAzQ0VBQkFDMjUKUldRbHJLdk9BMU1xQWZCakFseU1ibkY4bXZHNXRhWG5STVlYTk5mbFdVUm5TUCtpaUx5a1NKTkQK",
      "endpoints": [
        "https://github.com/tariktekin8/sapgui-launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
